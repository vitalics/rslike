{
  "name": "@rslike/iter",
  "version": "1.1.0",
  "description": "JavaScript Iteration library",
  "private": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "docs": "pnpm typedoc src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./globals": {
      "import": {
        "types": "./dist/globals.d.mts",
        "default": "./dist/globals.mjs"
      },
      "require": {
        "types": "./dist/globals.d.ts",
        "default": "./dist/globals.cjs"
      }
    },
    "./par-iter": {
      "import": {
        "types": "./dist/parIter.d.mts",
        "default": "./dist/parIter.mjs"
      },
      "require": {
        "types": "./dist/parIter.d.ts",
        "default": "./dist/parIter.cjs"
      }
    },
    "./worker-par-iter": {
      "import": {
        "types": "./dist/workerParIter.d.mts",
        "default": "./dist/workerParIter.mjs"
      },
      "require": {
        "types": "./dist/workerParIter.d.ts",
        "default": "./dist/workerParIter.cjs"
      }
    },
    "./async-iter": {
      "import": {
        "types": "./dist/asyncIter.d.mts",
        "default": "./dist/asyncIter.mjs"
      },
      "require": {
        "types": "./dist/asyncIter.d.ts",
        "default": "./dist/asyncIter.cjs"
      }
    }
  },
  "keywords": [
    "iter",
    "iterator",
    "iteration",
    "lazy",
    "generator",
    "parallel",
    "worker",
    "rayon",
    "rust like",
    "rust"
  ],
  "author": "Vitali Haradkou",
  "license": "MIT",
  "homepage": "https://github.com/vitalics/rslike/blob/main/packages/iter/README.md",
  "bugs": {
    "url": "https://github.com/vitalics/rslike/issues",
    "email": "vitalicset@yandex.ru"
  },
  "dependencies": {
    "@rslike/std": "workspace:*",
    "@rslike/cmp": "workspace:*"
  },
  "devDependencies": {
    "vitest": "3.2.6"
  }
}
