{
  "name": "@rslike/iter",
  "version": "1.0.0",
  "description": "JavaScript Iteration library",
  "private": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "docs": "pnpm typedoc src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./globals": {
      "import": {
        "types": "./dist/globals.d.mts",
        "default": "./dist/globals.mjs"
      },
      "require": {
        "types": "./dist/globals.d.ts",
        "default": "./dist/globals.cjs"
      }
    }
  },
  "keywords": [
    "std",
    "standard",
    "undefined behavior",
    "try",
    "try/catch",
    "try/catch/finally",
    "rust like",
    "rust",
    "option",
    "result"
  ],
  "author": "Vitali Haradkou",
  "license": "MIT",
  "homepage": "https://github.com/vitalics/rslike/blob/main/packages/iter/README.md",
  "bugs": {
    "url": "https://github.com/vitalics/rslike/issues",
    "email": "vitalicset@yandex.ru"
  },
  "dependencies": {
    "@rslike/std": "workspace:*",
    "@rslike/cmp": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.0"
  }
}
